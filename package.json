{
  "name": "dsh-selective-trim",
  "version": "0.1.32",
  "description": "DSH 会话瘦身面板：可选、可反悔地按段修剪会话，折叠重复系统注入，写盘前备份并用宿主校验器验过再落盘。",
  "license": "MIT",
  "author": "Azyzg <3041771087@qq.com>",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "session",
    "trim",
    "selective",
    "context",
    "compaction",
    "billion-context"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Azyzg/dsh-selective-trim.git"
  },
  "bugs": {
    "url": "https://github.com/Azyzg/dsh-selective-trim/issues"
  },
  "homepage": "https://github.com/Azyzg/dsh-selective-trim#readme",
  "type": "module",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  }
}
